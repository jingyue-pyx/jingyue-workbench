# Reference template only. Never put real credentials in source or a release.
# Set these values privately in the server's environment/secret configuration.
WORKBENCH_OWNER_ID=<one-stable-workspace-uuid>
JINGYUE_DATABASE_URL=postgresql://jingyue_app:<percent-encoded-password>@<official-rds-host>:5432/jingyue

# Default: strict TLS, verifying the official host and certificate.
# Supply only an official CA if necessary; do not disable verification.
# JINGYUE_DATABASE_CA=<official-PEM-CA>

# APPROVED PRIVATE DEMO ONLY. NOT FOR PRODUCTION.
# FC-to-DB credentials/data are NOT encrypted in this mode. Website HTTPS
# and Basic auth still apply to the browser-to-FC connection, not FC-to-DB.
# Both flags must be set exactly; use the same exact host in the URL above.
# DNS must resolve ONLY to IPv4 addresses in 172.26.0.0/20; port must be 5432.
# Remove JINGYUE_DATABASE_CA entirely before enabling this exception.
# JINGYUE_DEMO_PRIVATE_PLAINTEXT=1
# JINGYUE_DEMO_PRIVATE_HOST=pgm-j6cdnxlsd0mjok7u.rwlb.cnhk.rds.aliyuncs.com

# For production use a TLS-capable database, remove BOTH demo flags and test
# certificate/hostname verification. Never put DB variables in browser settings.
