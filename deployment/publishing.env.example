# Disabled until a Jingyue-owned OAuth application and live acceptance exist.
JINGYUE_NETLIFY_ENABLED=0
# From YOUR Netlify OAuth application; do not copy another application's ID.
JINGYUE_NETLIFY_CLIENT_ID=
# Base64 encoding of 32 cryptographically random bytes; server-only secret.
# Keep stable across restarts; rotation needs re-encryption or reauthorization.
JINGYUE_PUBLISHING_ENCRYPTION_KEY=
